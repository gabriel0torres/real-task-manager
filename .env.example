# Copie para ".env" e ajuste. Usado pelo docker compose e pela execução manual.

# ---------------------------------------------------------------- acesso
# Usuário administrador criado na primeira inicialização.
RTS_ADMIN_USERNAME=admin
# Se vazio, uma senha aleatória é gerada, mostrada no log da API e precisa ser trocada no 1º acesso.
RTS_ADMIN_PASSWORD=
# Duração da sessão no navegador (horas)
RTS_SESSION_TTL_HOURS=168
# true quando a interface for servida por HTTPS (cookie "Secure")
RTS_COOKIE_SECURE=false
# Endereço público da interface, usado nos links das notificações (ex.: https://rts.empresa.com)
RTS_PUBLIC_URL=

# ---------------------------------------------------------------- dados
# Diretório de dados (banco SQLite, chave secreta, diretórios de trabalho das tarefas)
RTS_DATA_DIR=./data
# Banco. Vazio = SQLite em $RTS_DATA_DIR/rts.db.
# PostgreSQL: postgresql+psycopg://usuario:senha@host:5432/rts
RTS_DATABASE_URL=
# Chave Fernet que cifra os segredos. Se vazia, é gerada em $RTS_DATA_DIR/secret.key.
# FAÇA BACKUP: sem ela os segredos não podem ser recuperados.
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RTS_SECRET_KEY=

# ---------------------------------------------------------------- agendamento
RTS_DEFAULT_TIMEZONE=America/Sao_Paulo
# Segundos de atraso tolerados num disparo antes de aplicar a política de execução perdida
RTS_MISFIRE_GRACE_SECONDS=60
# Tamanho máximo do log armazenado por execução (bytes)
RTS_MAX_LOG_BYTES=5000000
# Rodar o motor dentro do processo da API (apenas desenvolvimento)
RTS_EMBEDDED_WORKER=false
# Aplicar migrations automaticamente ao iniciar a API/worker
RTS_AUTO_MIGRATE=true
RTS_LOG_LEVEL=INFO

# ---------------------------------------------------------------- docker compose
RTS_PORT=8000
TZ=America/Sao_Paulo
# Senha do PostgreSQL do perfil "postgres"
POSTGRES_PASSWORD=rts
