# Diretório de dados (banco SQLite, chave secreta, workspaces das tarefas)
RTS_DATA_DIR=./data

# URL do banco. Padrão: SQLite em $RTS_DATA_DIR/rts.db
# PostgreSQL: postgresql+psycopg://usuario:senha@host:5432/rts
# RTS_DATABASE_URL=

# Chave Fernet usada para cifrar variáveis secretas.
# Se ausente, é gerada em $RTS_DATA_DIR/secret.key na primeira inicialização.
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RTS_SECRET_KEY=

# Fuso horário padrão das tarefas sem fuso próprio
RTS_DEFAULT_TIMEZONE=America/Sao_Paulo

# Aplicar migrations automaticamente ao iniciar a API/worker
RTS_AUTO_MIGRATE=true

# Rodar o motor de agendamento dentro do processo da API (desenvolvimento).
# Em produção use um processo separado: `rts-worker` (ou `python -m rts.worker`).
RTS_EMBEDDED_WORKER=false

# Tamanho máximo do log armazenado por execução (bytes)
RTS_MAX_LOG_BYTES=5000000

# Segundos de atraso tolerados num disparo antes de aplicar a política de execução perdida
RTS_MISFIRE_GRACE_SECONDS=60
